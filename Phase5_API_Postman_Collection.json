                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": \"C000001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/predict/churn",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "predict", "churn"]
